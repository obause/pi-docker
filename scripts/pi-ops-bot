#!/usr/bin/env python3
"""Private Telegram operations bot with confirmed maintenance actions."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import socket
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


TOKEN_PATTERN = re.compile(r"^[0-9]+:[A-Za-z0-9_-]+$")
COMMAND_PATTERN = re.compile(r"^/([a-z_]+)(?:@[A-Za-z0-9_]+)?(?:\s|$)")
STATUS_COMMANDS = {"status", "zigbee", "containers", "backup", "host", "alerts"}
DIAGNOSTIC_VIEWS = {
    "diagnose-overview",
    "diagnose-zigbee",
    "diagnose-containers",
    "diagnose-backup",
    "diagnose-host",
}
HISTORY_VIEWS = {"history-24h", "history-7d"}
SERVER_COMMANDS = STATUS_COMMANDS | DIAGNOSTIC_VIEWS | HISTORY_VIEWS
STATUS_SOCKET = "/run/pi-ops-status/status.sock"
MAX_SOCKET_RESPONSE = 16384
CONFIRM_TOKEN_PATTERN = re.compile(r"^[A-Za-z0-9_-]{20,32}$")
CONTAINER_NAMES = (
    "agent-zero",
    "docker-socket-proxy-1",
    "dyndns",
    "govee2mqtt",
    "homeassistant",
    "matter-server",
    "mosquitto",
    "pihole",
    "portainer",
    "traefik",
    "zigbee2mqtt",
)
COMMAND_DESCRIPTIONS = [
    ("status", "Gesamtstatus anzeigen"),
    ("diagnose", "Geführte Diagnose starten"),
    ("history", "Statusverlauf anzeigen"),
    ("maintenance", "Bestätigte Wartung öffnen"),
    ("restart", "Container-Neustart vorbereiten"),
    ("zigbee", "Zigbee-Funkpfad prüfen"),
    ("containers", "Containerstatus anzeigen"),
    ("backup", "Backupstatus anzeigen"),
    ("host", "Hostzustand anzeigen"),
    ("alerts", "Aktuelle Warnungen anzeigen"),
    ("help", "Hilfe und Befehle"),
]


class TelegramError(RuntimeError):
    pass


def api_request(token: str, method: str, parameters: dict | None = None, timeout: int = 20):
    encoded: dict[str, str] = {}
    for key, value in (parameters or {}).items():
        encoded[key] = json.dumps(value, separators=(",", ":")) if isinstance(value, (dict, list)) else str(value)
    request = urllib.request.Request(
        f"https://api.telegram.org/bot{token}/{method}",
        data=urllib.parse.urlencode(encoded).encode("utf-8"),
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as error:
        raise TelegramError(f"Telegram HTTP {error.code}") from None
    except (urllib.error.URLError, TimeoutError, OSError):
        raise TelegramError("Telegram nicht erreichbar") from None
    except (json.JSONDecodeError, UnicodeDecodeError):
        raise TelegramError("Ungültige Telegram-Antwort") from None
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        raise TelegramError("Telegram-Anfrage abgelehnt")
    return payload.get("result")


def load_config(path: Path) -> tuple[str, int, int]:
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
        token = config["bot_token"]
        chat_id = int(config["chat_id"])
        user_id = int(config.get("user_id", chat_id))
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        raise RuntimeError("Telegram-Credential ist ungültig") from None
    if not isinstance(token, str) or not TOKEN_PATTERN.fullmatch(token):
        raise RuntimeError("Telegram-Credential ist ungültig")
    if chat_id <= 0 or user_id <= 0:
        raise RuntimeError("Nur ein privater Telegram-Chat ist erlaubt")
    return token, chat_id, user_id


def keyboard(command: str | None = None) -> dict:
    if command in {"maintenance", "action-result"}:
        return {
            "inline_keyboard": [
                [
                    {"text": "🩺 Health-Check", "callback_data": "act:prepare:health-check"},
                    {"text": "💾 Backup starten", "callback_data": "act:prepare:backup"},
                ],
                [
                    {"text": "📡 Zigbee2MQTT neu", "callback_data": "act:prepare:restart:zigbee2mqtt"},
                    {"text": "🐳 Container wählen", "callback_data": "restart:list"},
                ],
                [{"text": "⚠️ Raspberry Pi neu starten", "callback_data": "act:prepare:reboot"}],
                [
                    {"text": "📊 Status", "callback_data": "show:status"},
                    {"text": "☰ Menü", "callback_data": "menu"},
                ],
            ]
        }
    if command == "restart-list":
        rows = []
        for index in range(0, len(CONTAINER_NAMES), 2):
            rows.append(
                [
                    {"text": name, "callback_data": f"act:prepare:restart:{name}"}
                    for name in CONTAINER_NAMES[index : index + 2]
                ]
            )
        rows.append(
            [
                {"text": "← Wartung", "callback_data": "maintenance"},
                {"text": "☰ Menü", "callback_data": "menu"},
            ]
        )
        return {"inline_keyboard": rows}
    if command in DIAGNOSTIC_VIEWS:
        rows = [
            [
                {"text": "🩺 Gesamtbild", "callback_data": "diag:overview"},
                {"text": "📡 Zigbee", "callback_data": "diag:zigbee"},
            ],
            [
                {"text": "🐳 Container", "callback_data": "diag:containers"},
                {"text": "💾 Backup", "callback_data": "diag:backup"},
            ],
            [
                {"text": "🖥️ Host", "callback_data": "diag:host"},
                {"text": "🕓 Verlauf", "callback_data": "history:24h"},
            ],
            [
                {"text": "↻ Aktualisieren", "callback_data": command.replace("diagnose-", "diag:")},
                {"text": "☰ Menü", "callback_data": "menu"},
            ],
        ]
        return {"inline_keyboard": rows}
    if command in HISTORY_VIEWS:
        period = command.removeprefix("history-")
        rows = [
            [
                {"text": "24 Stunden", "callback_data": "history:24h"},
                {"text": "7 Tage", "callback_data": "history:7d"},
            ],
            [
                {"text": "🩺 Diagnose", "callback_data": "diag:overview"},
                {"text": "↻ Aktualisieren", "callback_data": f"history:{period}"},
            ],
            [{"text": "☰ Menü", "callback_data": "menu"}],
        ]
        return {"inline_keyboard": rows}
    rows = [
        [
            {"text": "📊 Status", "callback_data": "show:status"},
            {"text": "🩺 Diagnose", "callback_data": "diag:overview"},
        ],
        [
            {"text": "📡 Zigbee", "callback_data": "show:zigbee"},
            {"text": "🐳 Container", "callback_data": "show:containers"},
        ],
        [
            {"text": "💾 Backup", "callback_data": "show:backup"},
            {"text": "🖥️ Host", "callback_data": "show:host"},
        ],
        [
            {"text": "🔔 Warnungen", "callback_data": "show:alerts"},
            {"text": "🕓 Verlauf", "callback_data": "history:24h"},
        ],
        [{"text": "🛠 Bestätigte Wartung", "callback_data": "maintenance"}],
    ]
    if command in STATUS_COMMANDS:
        rows.append([
            {"text": "↻ Aktualisieren", "callback_data": f"show:{command}"},
            {"text": "☰ Menü", "callback_data": "menu"},
        ])
    return {"inline_keyboard": rows}


def menu_text() -> str:
    return (
        "🤖 Raspberry-Pi Operations Bot\n\n"
        "Status, Diagnose und Verlauf sind rein lesend. In der Wartungsansicht kann ich "
        "wenige fest definierte Aktionen ausführen – immer erst nach einer zweiten, "
        "serverseitig geprüften Bestätigung.\n\n"
        "Wähle einen Bereich oder sende /help."
    )


def help_text() -> str:
    commands = "\n".join(f"/{command} — {description}" for command, description in COMMAND_DESCRIPTIONS)
    return (
        f"ℹ️ Verfügbare Befehle\n\n{commands}\n\n"
        "Du kannst auch kurze Sätze wie „Zigbee geht nicht“, „Backup prüfen“ oder "
        "„Docker Problem“ senden. Die Zuordnung ist deterministisch und bleibt rein lesend."
    )


def socket_request(request: str) -> tuple[str, list[str]]:
    try:
        chunks: list[bytes] = []
        received = 0
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(65)
            connection.connect(STATUS_SOCKET)
            connection.sendall(f"{request}\n".encode("ascii"))
            connection.shutdown(socket.SHUT_WR)
            while received < MAX_SOCKET_RESPONSE:
                chunk = connection.recv(min(1024, MAX_SOCKET_RESPONSE - received))
                if not chunk:
                    break
                chunks.append(chunk)
                received += len(chunk)
        output = b"".join(chunks).decode("utf-8").strip()
    except (OSError, TimeoutError, UnicodeDecodeError):
        return "ERROR", ["Lokaler Aktionsdienst ist momentan nicht verfügbar."]
    if not output:
        return "ERROR", ["Lokaler Aktionsdienst lieferte keine Antwort."]
    lines = output.splitlines()
    return lines[0], lines[1:]


def run_status(command: str) -> str:
    if command not in SERVER_COMMANDS:
        return help_text()
    status, lines = socket_request(command)
    if status != "OK" or not lines:
        return "🔴 Statusabfrage ist momentan nicht verfügbar."
    return "\n".join(lines)[:3900]


def action_allowed(action: str) -> bool:
    if action in {"health-check", "backup", "reboot"}:
        return True
    return action.startswith("restart:") and action.removeprefix("restart:") in CONTAINER_NAMES


def prepare_action(action: str) -> tuple[str | None, str]:
    if not action_allowed(action):
        return None, "🔴 Diese Wartungsaktion ist nicht freigegeben."
    status, lines = socket_request(f"prepare:{action}")
    if status != "CONFIRM" or len(lines) < 2 or not CONFIRM_TOKEN_PATTERN.fullmatch(lines[0]):
        return None, "🔴 Bestätigung konnte nicht vorbereitet werden."
    return lines[0], "⚠️ Bestätigung erforderlich\n\n" + "\n".join(lines[1:])


def finish_action(operation: str, token: str) -> str:
    if operation not in {"confirm", "cancel"} or not CONFIRM_TOKEN_PATTERN.fullmatch(token):
        return "🔴 Bestätigung ist ungültig."
    status, lines = socket_request(f"{operation}:{token}")
    if not lines:
        return "🔴 Wartungsdienst lieferte kein Ergebnis."
    text = "\n".join(lines)
    if status == "OK":
        return text
    return f"🔴 {text}"


def confirmation_keyboard(token: str) -> dict:
    return {
        "inline_keyboard": [
            [
                {"text": "✅ Jetzt ausführen", "callback_data": f"act:confirm:{token}"},
                {"text": "Abbrechen", "callback_data": f"act:cancel:{token}"},
            ]
        ]
    }


def maintenance_text() -> str:
    return (
        "🛠 Bestätigte Wartung\n\n"
        "Jede Aktion besitzt eine feste Zielmenge. Nach der Auswahl erscheint eine zweite "
        "Bestätigung, die nach 90 Sekunden verfällt und nur einmal verwendet werden kann.\n\n"
        "Nicht angeboten werden Shellbefehle, Docker-Prune oder automatische Updates."
    )


def restart_list_text() -> str:
    return (
        "🐳 Container neu starten\n\n"
        "Wähle genau einen bekannten Container. Vor dem Neustart folgt noch die verbindliche Bestätigung."
    )


def text_intent(text: str) -> str | None:
    normalized = text.casefold()
    if "zigbee" in normalized or "koordinator" in normalized:
        return "diagnose-zigbee"
    if "backup" in normalized or "borg" in normalized or "sicherung" in normalized:
        return "diagnose-backup"
    if any(word in normalized for word in ("container", "docker", "dienst", "service")):
        return "diagnose-containers"
    if any(word in normalized for word in ("host", "raspi", "speicher", "temperatur", "ram")):
        return "diagnose-host"
    if any(word in normalized for word in ("verlauf", "history", "historie")):
        return "history-24h"
    if any(word in normalized for word in ("fehler", "problem", "diagnose", "warum", "kaputt")):
        return "diagnose-overview"
    return None


def save_offset(path: Path, offset: int) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=".offset.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="ascii") as stream:
            stream.write(f"{offset}\n")
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def load_offset(path: Path) -> int:
    try:
        return max(0, int(path.read_text(encoding="ascii").strip()))
    except (OSError, ValueError):
        return 0


def authorized_message(message: object, chat_id: int, user_id: int) -> bool:
    if not isinstance(message, dict):
        return False
    chat = message.get("chat")
    sender = message.get("from")
    return (
        isinstance(chat, dict)
        and chat.get("type") == "private"
        and chat.get("id") == chat_id
        and isinstance(sender, dict)
        and sender.get("id") == user_id
    )


def authorized_callback(callback: object, chat_id: int, user_id: int) -> bool:
    if not isinstance(callback, dict):
        return False
    sender = callback.get("from")
    message = callback.get("message")
    chat = message.get("chat") if isinstance(message, dict) else None
    return (
        isinstance(sender, dict)
        and sender.get("id") == user_id
        and isinstance(chat, dict)
        and chat.get("type") == "private"
        and chat.get("id") == chat_id
    )


def send_view(
    token: str,
    chat_id: int,
    text: str,
    command: str | None = None,
    message_id: int | None = None,
    reply_markup: dict | None = None,
) -> None:
    parameters: dict = {
        "chat_id": chat_id,
        "text": text[:3900],
        "reply_markup": reply_markup if reply_markup is not None else keyboard(command),
        "disable_web_page_preview": True,
    }
    method = "sendMessage"
    if message_id is not None:
        method = "editMessageText"
        parameters["message_id"] = message_id
    try:
        api_request(token, method, parameters)
    except TelegramError:
        if message_id is None:
            raise


def handle_message(token: str, chat_id: int, message: dict) -> None:
    text = message.get("text")
    if not isinstance(text, str):
        send_view(token, chat_id, help_text())
        return
    match = COMMAND_PATTERN.match(text.strip())
    if not match:
        view = text_intent(text)
        if view is None:
            send_view(token, chat_id, help_text())
        else:
            send_view(token, chat_id, run_status(view), view)
        return
    command = match.group(1)
    parts = text.strip().split(maxsplit=1)
    argument = parts[1].strip() if len(parts) == 2 else ""
    if command in {"start", "menu"}:
        send_view(token, chat_id, menu_text())
    elif command == "help":
        send_view(token, chat_id, help_text())
    elif command == "diagnose":
        send_view(token, chat_id, run_status("diagnose-overview"), "diagnose-overview")
    elif command == "history":
        send_view(token, chat_id, run_status("history-24h"), "history-24h")
    elif command == "maintenance":
        send_view(token, chat_id, maintenance_text(), "maintenance")
    elif command == "restart":
        if not argument:
            send_view(token, chat_id, restart_list_text(), "restart-list")
        elif argument in CONTAINER_NAMES:
            confirmation_token, confirmation_text = prepare_action(f"restart:{argument}")
            markup = confirmation_keyboard(confirmation_token) if confirmation_token else keyboard("maintenance")
            send_view(token, chat_id, confirmation_text, reply_markup=markup)
        else:
            send_view(token, chat_id, "🔴 Unbekannter Container. Wähle einen Eintrag aus der Liste.", "restart-list")
    elif command in STATUS_COMMANDS:
        send_view(token, chat_id, run_status(command), command)
    else:
        send_view(token, chat_id, help_text())


def handle_callback(token: str, chat_id: int, callback: dict) -> None:
    callback_id = callback.get("id")
    if isinstance(callback_id, str):
        try:
            api_request(token, "answerCallbackQuery", {"callback_query_id": callback_id})
        except TelegramError:
            pass
    message = callback.get("message")
    if not isinstance(message, dict) or not isinstance(message.get("message_id"), int):
        return
    data = callback.get("data")
    if data == "menu":
        send_view(token, chat_id, menu_text(), message_id=message["message_id"])
        return
    if data == "maintenance":
        send_view(token, chat_id, maintenance_text(), "maintenance", message["message_id"])
        return
    if data == "restart:list":
        send_view(token, chat_id, restart_list_text(), "restart-list", message["message_id"])
        return
    if isinstance(data, str) and data.startswith("act:prepare:"):
        action = data.removeprefix("act:prepare:")
        confirmation_token, confirmation_text = prepare_action(action)
        markup = confirmation_keyboard(confirmation_token) if confirmation_token else keyboard("maintenance")
        send_view(
            token,
            chat_id,
            confirmation_text,
            message_id=message["message_id"],
            reply_markup=markup,
        )
        return
    if isinstance(data, str) and data.startswith("act:confirm:"):
        confirmation_token = data.removeprefix("act:confirm:")
        result = finish_action("confirm", confirmation_token)
        send_view(token, chat_id, result, "action-result", message["message_id"])
        return
    if isinstance(data, str) and data.startswith("act:cancel:"):
        confirmation_token = data.removeprefix("act:cancel:")
        result = finish_action("cancel", confirmation_token)
        send_view(token, chat_id, result, "maintenance", message["message_id"])
        return
    if isinstance(data, str) and data.startswith("show:"):
        command = data[5:]
        if command in STATUS_COMMANDS:
            send_view(token, chat_id, run_status(command), command, message["message_id"])
        return
    diagnostic_callbacks = {
        "diag:overview": "diagnose-overview",
        "diag:zigbee": "diagnose-zigbee",
        "diag:containers": "diagnose-containers",
        "diag:backup": "diagnose-backup",
        "diag:host": "diagnose-host",
    }
    if isinstance(data, str) and data in diagnostic_callbacks:
        command = diagnostic_callbacks[data]
        send_view(token, chat_id, run_status(command), command, message["message_id"])
        return
    history_callbacks = {"history:24h": "history-24h", "history:7d": "history-7d"}
    if isinstance(data, str) and data in history_callbacks:
        command = history_callbacks[data]
        send_view(token, chat_id, run_status(command), command, message["message_id"])


def configure_commands(token: str, chat_id: int) -> None:
    api_request(
        token,
        "setMyCommands",
        {
            "commands": [{"command": command, "description": description} for command, description in COMMAND_DESCRIPTIONS],
            "scope": {"type": "chat", "chat_id": chat_id},
            "language_code": "de",
        },
    )


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: pi-ops-bot CREDENTIAL OFFSET", file=sys.stderr)
        return 2
    credential_path = Path(sys.argv[1])
    offset_path = Path(sys.argv[2])
    try:
        token, chat_id, user_id = load_config(credential_path)
        configure_commands(token, chat_id)
    except (RuntimeError, TelegramError) as error:
        print(f"Start fehlgeschlagen: {error}", file=sys.stderr)
        return 1

    offset = load_offset(offset_path)
    last_action = 0.0
    print("Telegram Operations Bot gestartet", flush=True)
    while True:
        try:
            updates = api_request(
                token,
                "getUpdates",
                {"offset": offset, "timeout": 50, "limit": 20, "allowed_updates": ["message", "callback_query"]},
                timeout=65,
            )
        except TelegramError as error:
            print(f"Polling fehlgeschlagen: {error}", file=sys.stderr, flush=True)
            time.sleep(5)
            continue
        if not isinstance(updates, list):
            time.sleep(2)
            continue
        for update in updates:
            if not isinstance(update, dict) or not isinstance(update.get("update_id"), int):
                continue
            offset = max(offset, update["update_id"] + 1)
            save_offset(offset_path, offset)
            message = update.get("message")
            callback = update.get("callback_query")
            if authorized_message(message, chat_id, user_id):
                delay = 0.8 - (time.monotonic() - last_action)
                if delay > 0:
                    time.sleep(delay)
                try:
                    handle_message(token, chat_id, message)
                except TelegramError as error:
                    print(f"Antwort fehlgeschlagen: {error}", file=sys.stderr, flush=True)
                last_action = time.monotonic()
                continue
            if authorized_callback(callback, chat_id, user_id):
                delay = 0.8 - (time.monotonic() - last_action)
                if delay > 0:
                    time.sleep(delay)
                handle_callback(token, chat_id, callback)
                last_action = time.monotonic()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
