#!/usr/bin/env bash
set -u

failures=0

fail() {
    printf 'ERROR %s\n' "$1"
    failures=$((failures + 1))
}

check_http() {
    local name=$1
    local url=$2
    local expected=$3
    local resolve=${4:-}
    local code
    local curl_args=(
        --insecure
        --silent
        --show-error
        --output /dev/null
        --write-out '%{http_code}'
        --max-time 8
    )

    if [[ -n $resolve ]]; then
        curl_args+=(--resolve "$resolve")
    fi

    code=$(curl "${curl_args[@]}" "$url" 2>/dev/null) || code=000

    case ",$expected," in
        *",$code,"*) ;;
        *) fail "$name returned HTTP $code (expected $expected)" ;;
    esac
}

expected_containers=(
    docker-socket-proxy-1
    dyndns
    govee2mqtt
    homeassistant
    matter-server
    mosquitto
    pihole
    portainer
    traefik
    zigbee2mqtt
)

for container in "${expected_containers[@]}"; do
    state=$(timeout 10 docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null) || {
        fail "$container is missing"
        continue
    }
    if [[ $state != running ]]; then
        fail "$container state is $state"
        continue
    fi

    status=$(timeout 10 docker ps --filter "name=^/${container}$" --format '{{.Status}}') || {
        fail "Docker did not answer while checking $container"
        continue
    }
    if [[ $status == *"(unhealthy)"* ]]; then
        fail "$container is unhealthy"
    elif [[ $status == *"(health: starting)"* ]]; then
        fail "$container health is still starting"
    fi
done

zigbee_result=$(timeout 30 /usr/local/sbin/pi-zigbee-coordinator-check 2>&1)
if (( $? != 0 )); then
    fail "${zigbee_result#ERROR }"
fi

if ! systemctl is-active --quiet pi-borg-backup.timer; then
    fail 'pi-borg-backup.timer is not active'
fi

if ! systemctl is-active --quiet fail2ban.service; then
    fail 'fail2ban.service is not active'
fi

backup_result=$(systemctl show pi-borg-backup.service --property Result --value)
if [[ $backup_result != success ]]; then
    fail "last Borg backup result is $backup_result"
fi

root_used=$(df --output=pcent / | tail -n 1 | tr -cd '0-9')
if [[ -z $root_used || $root_used -ge 85 ]]; then
    fail "root filesystem usage is ${root_used:-unknown}%"
fi

mem_total_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
mem_available_kib=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
mem_available_pct=$((100 * mem_available_kib / mem_total_kib))
if (( mem_available_pct < 10 )); then
    fail "available memory is ${mem_available_pct}%"
fi

swap_total_kib=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)
swap_free_kib=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)
swap_used_pct=0
if (( swap_total_kib > 0 )); then
    swap_used_pct=$((100 * (swap_total_kib - swap_free_kib) / swap_total_kib))
fi
if (( swap_used_pct >= 95 && mem_available_pct < 20 )); then
    fail "swap is ${swap_used_pct}% used while available memory is ${mem_available_pct}%"
fi

check_dns() {
    local protocol=$1
    local -a protocol_args=()
    local answer

    if [[ $protocol == tcp ]]; then
        protocol_args+=(+tcp)
    fi

    answer=$(timeout 8 docker exec pihole dig "${protocol_args[@]}" \
        +time=2 +tries=1 @127.0.0.1 example.com A +short 2>/dev/null) || {
        fail "Pi-hole DNS over $protocol did not answer"
        return
    }
    if [[ -z $answer ]]; then
        fail "Pi-hole DNS over $protocol returned no address"
    fi
}

check_dns udp
check_dns tcp

check_http homeassistant http://127.0.0.1:8123/ 200
check_http matter http://127.0.0.1:5580/ 200
check_http pihole https://pihole.bause.lan/ 301,302 pihole.bause.lan:443:127.0.0.1
check_http zigbee2mqtt https://zigbee.bause.lan/ 200 zigbee.bause.lan:443:127.0.0.1
check_http portainer https://portainer.bause.lan/ 200 portainer.bause.lan:443:127.0.0.1
check_http traefik https://traefik.bause.lan/ 302 traefik.bause.lan:443:127.0.0.1

if (( failures > 0 )); then
    printf 'FAILED checks=%d\n' "$failures"
    exit 1
fi

printf 'OK containers=%d root_used=%s%% mem_available=%s%% swap_used=%s%% backup=%s fail2ban=active dns=udp,tcp zigbee_radio=ok endpoints=6\n' \
    "${#expected_containers[@]}" "$root_used" "$mem_available_pct" \
    "$swap_used_pct" "$backup_result"
